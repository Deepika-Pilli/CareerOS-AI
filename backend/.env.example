# ────────────────────────────────────────────────────
# CareerOS AI Backend — Production Environment Variables
# ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# MongoDB
# Required. Get from MongoDB Atlas (or self-hosted MongoDB).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careeros?retryWrites=true&w=majority

# JWT Secret
# Required. Generate a strong random string: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret_key

# CORS & Frontend URL
# Comma-separated list of allowed origins (no spaces).
CORS_ORIGIN=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Email (Optional — Emails will be logged to console if not configured)
# If using Gmail SMTP: use an App Password (not your regular password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@careeros-ai.com